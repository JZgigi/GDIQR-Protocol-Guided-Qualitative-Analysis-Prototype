NEXT_PUBLIC_APP_ENV=local
STORAGE_MODE=local
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_API_TIMEOUT_MS=300000
# Compact boundary-anchor response budget for each semantic participant window.
OLLAMA_MU_BOUNDARY_MAX_TOKENS=1200
OLLAMA_MU_CHUNK_TIMEOUT_MS=120000
# Whole browser job budget. A failed semantic job preserves the existing MU set
# and reports an error; it does not silently substitute structural spans.
NEXT_PUBLIC_MU_JOB_TIMEOUT_MS=5400000
OLLAMA_CATEGORY_MAX_TOKENS=1800
OLLAMA_REVIEWER_MAX_TOKENS=1200
OLLAMA_TRANSCRIPT_PROCESS_TIMEOUT_MS=300000
NEXT_PUBLIC_TRANSCRIPT_PREPARE_TIMEOUT_MS=300000
OLLAMA_TRANSCRIPT_PROCESS_MAX_TOKENS=4096
TRANSCRIPT_PROCESS_CHUNK_CHARS=6000
# Conversational context window for semantic MU delineation. Structural chunks
# inside this window are preprocessing only, never treated as MUs.
TRANSCRIPT_MU_WINDOW_CHARS=6000
PYTHON_BIN=python3
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
TRANSCRIPTION_TIMEOUT_MS=1800000

# Supabase placeholders for v1.0 release testing.
# GDIQR_DEFAULT_PROJECT_ID is a legacy internal env var name kept for compatibility.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GDIQR_DEFAULT_PROJECT_ID=proj_student_wellbeing
